<Window x:Class="ChatProgram.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="채팅 프로그램 (TCP / UDP)" Height="520" Width="600"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">

    <!-- 전체 레이아웃 : 3행 (연결 설정 / 대화 목록 / 입력) -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1행 : 연결 설정 -->
        <GroupBox Grid.Row="0" Header="연결 설정" Padding="5">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="방식" Width="55" VerticalAlignment="Center"/>
                    <ComboBox x:Name="protocolComboBox" Width="130" SelectedIndex="0">
                        <ComboBoxItem Content="TCP 서버"/>
                        <ComboBoxItem Content="TCP 클라이언트"/>
                        <ComboBoxItem Content="UDP"/>
                    </ComboBox>
                    <TextBlock Text="내 포트" Margin="15,0,5,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="localPortTextBox" Width="70" Text="9000"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="상대 IP" Width="55" VerticalAlignment="Center"/>
                    <TextBox x:Name="remoteIpTextBox" Width="130" Text="127.0.0.1"/>
                    <TextBlock Text="상대 포트" Margin="15,0,5,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="remotePortTextBox" Width="70" Text="9001"/>
                    <Button x:Name="connectButton" Content="연결" Width="70" Margin="15,0,5,0" Click="ConnectButton_Click"/>
                    <Button x:Name="disconnectButton" Content="해제" Width="70" IsEnabled="False" Click="DisconnectButton_Click"/>
                </StackPanel>
                <TextBlock Foreground="Gray" Margin="0,5,0,0" FontSize="11"
                           Text="※ TCP 서버: 내 포트만 사용 / TCP 클라이언트: 상대 IP·포트만 사용 / UDP: 모두 사용"/>
            </StackPanel>
        </GroupBox>

        <!-- 2행 : 대화 내용 -->
        <ListBox x:Name="chatListBox" Grid.Row="1" Margin="0,10,0,10"/>

        <!-- 3행 : 메시지 입력 -->
        <DockPanel Grid.Row="2">
            <Button x:Name="sendButton" DockPanel.Dock="Right" Content="전송" Width="70" Margin="5,0,0,0" Click="SendButton_Click"/>
            <TextBox x:Name="messageTextBox" KeyDown="MessageTextBox_KeyDown"/>
        </DockPanel>
    </Grid>
</Window>
