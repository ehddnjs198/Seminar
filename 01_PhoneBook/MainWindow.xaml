<Window x:Class="PhoneBook.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="전화번호부" Height="480" Width="520" WindowStartupLocation="CenterScreen">

    <!-- 전체 레이아웃 : 4행 (입력 / 검색 / 목록 / 하단) -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1행 : 추가 영역 -->
        <GroupBox Grid.Row="0" Header="연락처 추가" Padding="5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="이름" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="nameTextBox" Width="110" Margin="0,0,10,0"/>
                <TextBlock Text="전화번호" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="phoneTextBox" Width="140" Margin="0,0,10,0"/>
                <Button x:Name="addButton" Content="추가" Width="70" Click="AddButton_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- 2행 : 검색 영역 -->
        <GroupBox Grid.Row="1" Header="검색" Padding="5" Margin="0,5,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="searchTextBox" Width="285" Margin="0,0,10,0" KeyDown="SearchTextBox_KeyDown"/>
                <Button x:Name="searchButton" Content="검색" Width="70" Margin="0,0,5,0" Click="SearchButton_Click"/>
                <Button x:Name="showAllButton" Content="전체보기" Width="70" Click="ShowAllButton_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- 3행 : 전시 영역 (ListView + GridView = 표 형태) -->
        <ListView x:Name="contactListView" Grid.Row="2" Margin="0,10,0,10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="이름" Width="180" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="전화번호" Width="250" DisplayMemberBinding="{Binding PhoneNumber}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 4행 : 삭제 버튼 + 상태 표시 -->
        <DockPanel Grid.Row="3">
            <Button x:Name="deleteButton" DockPanel.Dock="Right" Content="선택 삭제" Width="90" Click="DeleteButton_Click"/>
            <TextBlock x:Name="statusTextBlock" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
