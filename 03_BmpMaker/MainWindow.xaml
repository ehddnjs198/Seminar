<Window x:Class="BmpMaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BMP 파일 생성기" Height="380" Width="640"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">

    <!-- 전체 레이아웃 : 3행 (크기 입력 / 미리보기 / 상태) -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1행 : 이미지 크기 입력 + 버튼 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="가로" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="widthTextBox" Width="60" Text="300"/>
            <TextBlock Text="세로" VerticalAlignment="Center" Margin="15,0,5,0"/>
            <TextBox x:Name="heightTextBox" Width="60" Text="200"/>
            <Button x:Name="createButton" Content="다시 생성" Width="80" Margin="15,0,5,0" Click="CreateButton_Click"/>
            <Button x:Name="openFolderButton" Content="폴더 열기" Width="80" Click="OpenFolderButton_Click"/>
        </StackPanel>

        <!-- 2행 : 생성된 R / G / B 파일 미리보기 -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,10,0,10">
            <StackPanel Margin="5">
                <TextBlock Text="Red.bmp" HorizontalAlignment="Center"/>
                <Border BorderBrush="Gray" BorderThickness="1" Height="160">
                    <Image x:Name="redImage" Stretch="Uniform"/>
                </Border>
            </StackPanel>
            <StackPanel Margin="5">
                <TextBlock Text="Green.bmp" HorizontalAlignment="Center"/>
                <Border BorderBrush="Gray" BorderThickness="1" Height="160">
                    <Image x:Name="greenImage" Stretch="Uniform"/>
                </Border>
            </StackPanel>
            <StackPanel Margin="5">
                <TextBlock Text="Blue.bmp" HorizontalAlignment="Center"/>
                <Border BorderBrush="Gray" BorderThickness="1" Height="160">
                    <Image x:Name="blueImage" Stretch="Uniform"/>
                </Border>
            </StackPanel>
        </UniformGrid>

        <!-- 3행 : 결과 메시지 -->
        <TextBlock x:Name="statusTextBlock" Grid.Row="2" TextWrapping="Wrap"/>
    </Grid>
</Window>
