<Window x:Class="BmpMaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BMP 파일 생성기" Height="560" Width="520"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">

    <!-- 전체 레이아웃 : 5행 (색상 / 크기 / 버튼 / 미리보기 / 상태) -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1행 : RGB 색상 입력 (0~255) + 색상 미리보기 -->
        <GroupBox Grid.Row="0" Header="색상 (0 ~ 255)" Padding="5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="R" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="Red" FontWeight="Bold"/>
                <TextBox x:Name="redTextBox" Width="50" Text="255" TextChanged="InputTextBox_TextChanged"/>
                <TextBlock Text="G" VerticalAlignment="Center" Margin="15,0,5,0" Foreground="Green" FontWeight="Bold"/>
                <TextBox x:Name="greenTextBox" Width="50" Text="0" TextChanged="InputTextBox_TextChanged"/>
                <TextBlock Text="B" VerticalAlignment="Center" Margin="15,0,5,0" Foreground="Blue" FontWeight="Bold"/>
                <TextBox x:Name="blueTextBox" Width="50" Text="0" TextChanged="InputTextBox_TextChanged"/>
                <TextBlock Text="색상" VerticalAlignment="Center" Margin="20,0,5,0"/>
                <Border x:Name="colorPreviewBorder" Width="60" Height="24" BorderBrush="Gray" BorderThickness="1"/>
            </StackPanel>
        </GroupBox>

        <!-- 2행 : 이미지 크기 입력 + 예상 파일 크기 -->
        <GroupBox Grid.Row="1" Header="이미지 크기 (픽셀) → 파일 크기 결정" Padding="5" Margin="0,5,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="가로" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="widthTextBox" Width="60" Text="300" TextChanged="InputTextBox_TextChanged"/>
                <TextBlock Text="세로" VerticalAlignment="Center" Margin="15,0,5,0"/>
                <TextBox x:Name="heightTextBox" Width="60" Text="200" TextChanged="InputTextBox_TextChanged"/>
                <TextBlock x:Name="fileSizeTextBlock" VerticalAlignment="Center" Margin="20,0,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- 3행 : 버튼 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="createButton" Content="BMP 생성" Width="90" Margin="0,0,5,0" Click="CreateButton_Click"/>
            <Button x:Name="openFolderButton" Content="폴더 열기" Width="90" Click="OpenFolderButton_Click"/>
        </StackPanel>

        <!-- 4행 : 생성된 파일 미리보기 -->
        <Border Grid.Row="3" BorderBrush="Gray" BorderThickness="1" Margin="0,10,0,10">
            <Image x:Name="resultImage" Stretch="Uniform" Margin="5"/>
        </Border>

        <!-- 5행 : 결과 메시지 -->
        <TextBlock x:Name="statusTextBlock" Grid.Row="4" TextWrapping="Wrap"/>
    </Grid>
</Window>
