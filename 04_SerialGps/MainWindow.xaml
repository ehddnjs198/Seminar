<Window x:Class="SerialGps.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GPS 시리얼 수신기" Height="600" Width="720"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">

    <!-- 공통 스타일 : 라벨 / 읽기 전용 텍스트박스 -->
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="labelStyle">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,8,3"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
    </Window.Resources>

    <!-- 전체 레이아웃 : 3행 (연결 / 좌표 전시 / NMEA 원본) -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1행 : 포트 설정 -->
        <GroupBox Grid.Row="0" Header="시리얼 포트 설정" Padding="5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="포트" Style="{StaticResource labelStyle}"/>
                <ComboBox x:Name="portComboBox" Width="90"/>
                <Button x:Name="refreshButton" Content="새로고침" Width="70" Margin="5,0,15,0" Click="RefreshButton_Click"/>
                <TextBlock Text="Baud Rate" Style="{StaticResource labelStyle}"/>
                <ComboBox x:Name="baudRateComboBox" Width="90"/>
                <Button x:Name="connectButton" Content="연결" Width="70" Margin="15,0,5,0" Click="ConnectButton_Click"/>
                <Button x:Name="disconnectButton" Content="해제" Width="70" IsEnabled="False" Click="DisconnectButton_Click"/>
                <TextBlock x:Name="statusTextBlock" Text="연결 안 됨" Style="{StaticResource labelStyle}" Margin="15,0,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- 2행 : 좌측 WGS84 / 우측 UTM + 상태 -->
        <Grid Grid.Row="1" Margin="0,5,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="WGS84 (십진수 도 / 도분초)" Padding="5" Margin="0,0,5,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="위도 (십진수)" Style="{StaticResource labelStyle}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="latitudeDecimalTextBox"/>
                    <TextBlock Grid.Row="1" Text="경도 (십진수)" Style="{StaticResource labelStyle}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="longitudeDecimalTextBox"/>
                    <TextBlock Grid.Row="2" Text="위도 (도분초)" Style="{StaticResource labelStyle}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="latitudeDmsTextBox"/>
                    <TextBlock Grid.Row="3" Text="경도 (도분초)" Style="{StaticResource labelStyle}"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="longitudeDmsTextBox"/>
                    <TextBlock Grid.Row="4" Text="고도" Style="{StaticResource labelStyle}"/>
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="altitudeTextBox"/>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="UTM / 수신 상태" Padding="5" Margin="5,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="UTM Zone" Style="{StaticResource labelStyle}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="utmZoneTextBox"/>
                    <TextBlock Grid.Row="1" Text="Easting" Style="{StaticResource labelStyle}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="eastingTextBox"/>
                    <TextBlock Grid.Row="2" Text="Northing" Style="{StaticResource labelStyle}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="northingTextBox"/>
                    <TextBlock Grid.Row="3" Text="UTC 시간" Style="{StaticResource labelStyle}"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="utcTimeTextBox"/>
                    <TextBlock Grid.Row="4" Text="측위 / 위성 / 속도" Style="{StaticResource labelStyle}"/>
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="fixInfoTextBox"/>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- 3행 : 수신된 NMEA 원본 문장 -->
        <GroupBox Grid.Row="2" Header="NMEA 원본 수신 데이터" Padding="5">
            <ListBox x:Name="rawDataListBox" FontFamily="Consolas" FontSize="11"/>
        </GroupBox>
    </Grid>
</Window>
